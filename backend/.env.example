# Copy this file to .env and fill in your values.

# From your app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a Redirect URI in your Spotify app settings.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/api/auth/spotify/callback

# Where the React app runs.
FRONTEND_URL=http://127.0.0.1:5173

# Any long random string. Used to sign login cookies.
SECRET_KEY=change-me

# SQLite file for local development. Use a postgresql:// URL in production.
DATABASE_URL=sqlite:///./matchmaker.db

# Show the "Try the demo" button that logs in as a fake test user.
DEMO_MODE=true
